# ==============================================================
# Variables de entorno del módulo Innovación Curricular (Artículo 7).
#
#   1. Copie este archivo:  cp .env.example .env
#   2. Cambie TODOS los valores por los suyos.
#   3. El .env NUNCA se sube a git: está en el .gitignore.
#
# Los valores de aquí son de MENTIRA: sirven para ver el formato.
# ==============================================================

# --- SQL Server ---
# Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo:
# si no cumple, SQL Server se niega a arrancar.
MSSQL_SA_PASSWORD=Cambie_Esta_Clave_123

# --- JWT (Entrega 3) ---
# Mínimo 32 caracteres. Es la llave con la que la API FIRMA los tokens:
# quien la conozca puede fabricar tokens válidos.
JWT_SECRETO=cambie-este-secreto-por-uno-largo-y-aleatorio-123456
JWT_MINUTOS=60

# --- Administrador inicial (Entrega 3) ---
# La API lo crea al arrancar SOLO si todavía no existe ningún
# administrador. La contraseña se guarda hasheada (PBKDF2), nunca en
# texto plano. Cámbiela después del primer ingreso.
ADMIN_USUARIO=admin
ADMIN_CORREO=admin@innovacion.local
ADMIN_CLAVE=Cambie_Esta_Clave_Admin_1
