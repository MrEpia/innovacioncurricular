@page "/acreditaciones"
@rendermode InteractiveServer
@inject ServicioAcreditacion Servicio
@inject ServicioPrograma ServicioProgramaPadre
@inject IJSRuntime JS

@*
    LA PANTALLA DE `acreditacion` (v2 — bloque Academico)

    El mismo patrón de las pantallas de la v1, con una diferencia: cada clave
    foránea es una LISTA DESPLEGABLE cargada desde la API por el servicio de
    su tabla padre, nunca escrita a mano ni leída de la base.
*@

<PageTitle>Acreditaciones</PageTitle>

<div class="encabezado">
    <div>
        <h1>Acreditaciones</h1>
        <p class="nota">Las acreditaciones de alta calidad otorgadas a los programas, por número de resolución.</p>
    </div>
    @if (!mostrandoFormulario)
    {
        <button class="boton primario" @onclick="Agregar">Agregar</button>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}
@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">
        <h2>@(editando ? "Editar" : "Agregar") la acreditación</h2>

        <label>
            Resolución
            <input type="number" @bind="campoResolucion" disabled="@editando" />
            <span class="ayuda">Forma parte de la llave: no se podrá cambiar después.</span>
        </label>

        <label>
            Tipo
            <input type="text" maxlength="45" @bind="campoTipo" />
        </label>

        <label>
            Calificación
            <input type="text" maxlength="45" @bind="campoCalificacion" />
        </label>

        <label>
            Fecha de inicio
            <input type="text" maxlength="45" @bind="campoFechaInicio" />
        </label>

        <label>
            Fecha de fin
            <input type="text" maxlength="45" @bind="campoFechaFin" />
        </label>

        <label>
            Programa
            <select @bind="campoPrograma">
                <option value="">— seleccione —</option>
                @foreach (var p in listaPrograma)
                {
                    <option value="@p.Id">@p.Id — @p.Nombre</option>
                }
            </select>
        </label>

        <div class="pareja">
            @if (editando)
            {
                <button class="boton primario" @onclick="GuardarCompleta" disabled="@guardando">
                    Guardar la ficha completa
                </button>
                <button class="boton" @onclick="GuardarLoQueCambio" disabled="@guardando">
                    Guardar solo lo que cambié
                </button>
            }
            else
            {
                <button class="boton primario" @onclick="Crear" disabled="@guardando">
                    Agregar
                </button>
            }
            <button class="boton" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
        </div>

        @if (editando)
        {
            <span class="ayuda">
                «La ficha completa» exige todos los datos obligatorios. «Solo lo que
                cambié» guarda únicamente lo que usted modificó.
            </span>
        }
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>Resolución</th>
                    <th>Tipo</th>
                    <th>Calificación</th>
                    <th>Fecha de inicio</th>
                    <th>Fecha de fin</th>
                    <th>Programa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td>@fila.Resolucion</td>
                        <td>@fila.Tipo</td>
                        <td>@fila.Calificacion</td>
                        <td>@fila.FechaInicio</td>
                        <td>@fila.FechaFin</td>
                        <td>@NombrePrograma(fila.Programa)</td>
                        <td>
                            <div class="acciones">
                                <button class="boton" @onclick="() => Editar(fila)">Editar</button>
                                <button class="boton peligro" @onclick="() => Retirar(fila)">Retirar</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="nota">@filas.Count registro(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay registros. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<Acreditacion> filas = new();
    private List<Programa> listaPrograma = new();
    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;
    private Acreditacion? original;

    private int? campoResolucion;
    private string campoTipo = string.Empty;
    private string campoCalificacion = string.Empty;
    private string campoFechaInicio = string.Empty;
    private string campoFechaFin = string.Empty;
    private int? campoPrograma;

    protected override async Task OnInitializedAsync()
    {
        errores = new();
        // Las listas desplegables: los registros ACTIVOS de cada tabla padre,
        // pedidos a la API por el servicio de esa tabla.
        var rPrograma = await ServicioProgramaPadre.Listar();
        if (rPrograma.Ok) listaPrograma = rPrograma.Datos!;
        else errores.AddRange(rPrograma.Errores);
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        var r = await Servicio.Listar();
        cargando = false;

        if (!r.Ok) errores.AddRange(r.Errores);
        filas = r.Ok ? r.Datos! : new();
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombrePrograma(int? llave)
    {
        if (llave == null) return "—";
        var p = listaPrograma.FirstOrDefault(x => Equals(x.Id, llave));
        return p == null ? $"{llave}" : $"{p.Id} — {p.Nombre}";
    }

    private Acreditacion Construir() => new Acreditacion
    {
            Resolucion = campoResolucion,
            Tipo = campoTipo.Trim(),
            Calificacion = campoCalificacion.Trim(),
            FechaInicio = campoFechaInicio.Trim(),
            FechaFin = campoFechaFin.Trim(),
            Programa = campoPrograma
    };

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Editar(Acreditacion fila)
    {
        campoResolucion = fila.Resolucion;
        campoTipo = fila.Tipo;
        campoCalificacion = fila.Calificacion;
        campoFechaInicio = fila.FechaInicio;
        campoFechaFin = fila.FechaFin;
        campoPrograma = fila.Programa;
        original = new Acreditacion
        {
            Resolucion = fila.Resolucion,
            Tipo = fila.Tipo,
            Calificacion = fila.Calificacion,
            FechaInicio = fila.FechaInicio,
            FechaFin = fila.FechaFin,
            Programa = fila.Programa
        };
        editando = true;
        mostrandoFormulario = true;
        errores = new();
        exito = string.Empty;
    }

    private async Task GuardarCompleta()
    {
        guardando = true;
        var r = await Servicio.Reemplazar(campoResolucion!.Value, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó la acreditación {campoResolucion}.");
    }

    private async Task GuardarLoQueCambio()
    {
        guardando = true;
        var r = await Servicio.Actualizar(campoResolucion!.Value, original!, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó la acreditación {campoResolucion}.");
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoResolucion = null;
        campoTipo = string.Empty;
        campoCalificacion = string.Empty;
        campoFechaInicio = string.Empty;
        campoFechaFin = string.Empty;
        campoPrograma = null;
        original = null;
        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;
        var r = await Servicio.Crear(Construir());
        guardando = false;
        await TrasGuardar(r, "Se agregó el registro.");
    }

    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(Acreditacion fila)
    {
        var seguro = await JS.InvokeAsync<bool>("confirm", $"¿Retirar {fila.Resolucion} del uso?");
        if (!seguro) return;

        var r = await Servicio.Eliminar(fila.Resolucion!.Value);
        if (r.Ok)
        {
            exito = $"Se retiró la acreditación {fila.Resolucion}.";
            errores = new();
            await Cargar();
        }
        else
        {
            // Un 409 llega aquí con su explicación: «tiene registros activos en…».
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
