@page "/actividades-registros"
@rendermode InteractiveServer
@inject ServicioAaRc Servicio
@inject ServicioActivAcademica ServicioActivAcademicaPadre
@inject ServicioRegistroCalificado ServicioRegistroCalificadoPadre
@inject IJSRuntime JS

@*
    LA PANTALLA DE `aa_rc` (v2 — bloque Actividades)

    El mismo patrón de las pantallas de la v1, con una diferencia: cada clave
    foránea es una LISTA DESPLEGABLE cargada desde la API por el servicio de
    su tabla padre, nunca escrita a mano ni leída de la base.
*@

<PageTitle>Actividades por registro calificado</PageTitle>

<div class="encabezado">
    <div>
        <h1>Actividades por registro calificado</h1>
        <p class="nota">Qué actividades académicas incluye cada registro calificado, con su componente y semestre.</p>
    </div>
    @if (!mostrandoFormulario)
    {
        <button class="boton primario" @onclick="Agregar">Agregar</button>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}
@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">
        <h2>@(editando ? "Editar" : "Agregar") la relación</h2>

        <label>
            Actividad académica
            <select @bind="campoActivAcademicasIdcurso" disabled="@editando">
                <option value="">— seleccione —</option>
                @foreach (var p in listaActivAcademicasIdcurso)
                {
                    <option value="@p.Id">@p.Id — @p.Nombre</option>
                }
            </select>
        </label>

        <label>
            Registro calificado
            <select @bind="campoRegistroCalificadoCodigo" disabled="@editando">
                <option value="">— seleccione —</option>
                @foreach (var p in listaRegistroCalificadoCodigo)
                {
                    <option value="@p.Codigo">@p.Codigo — @p.TipoTitulacion</option>
                }
            </select>
        </label>

        <label>
            Componente
            <input type="text" maxlength="45" @bind="campoComponente" />
        </label>

        <label>
            Semestre
            <input type="text" maxlength="45" @bind="campoSemestre" />
        </label>

        <div class="pareja">
            @if (editando)
            {
                <button class="boton primario" @onclick="GuardarCompleta" disabled="@guardando">
                    Guardar la ficha completa
                </button>
                <button class="boton" @onclick="GuardarLoQueCambio" disabled="@guardando">
                    Guardar solo lo que cambié
                </button>
            }
            else
            {
                <button class="boton primario" @onclick="Crear" disabled="@guardando">
                    Agregar
                </button>
            }
            <button class="boton" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
        </div>

        @if (editando)
        {
            <span class="ayuda">
                «La ficha completa» exige todos los datos obligatorios. «Solo lo que
                cambié» guarda únicamente lo que usted modificó.
            </span>
        }
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>Actividad académica</th>
                    <th>Registro calificado</th>
                    <th>Componente</th>
                    <th>Semestre</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td>@NombreActivAcademicasIdcurso(fila.ActivAcademicasIdcurso)</td>
                        <td>@NombreRegistroCalificadoCodigo(fila.RegistroCalificadoCodigo)</td>
                        <td>@fila.Componente</td>
                        <td>@fila.Semestre</td>
                        <td>
                            <div class="acciones">
                                <button class="boton" @onclick="() => Editar(fila)">Editar</button>
                                <button class="boton peligro" @onclick="() => Retirar(fila)">Retirar</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="nota">@filas.Count registro(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay registros. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<AaRc> filas = new();
    private List<ActivAcademica> listaActivAcademicasIdcurso = new();
    private List<RegistroCalificado> listaRegistroCalificadoCodigo = new();
    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;
    private AaRc? original;

    private int? campoActivAcademicasIdcurso;
    private int? campoRegistroCalificadoCodigo;
    private string campoComponente = string.Empty;
    private string campoSemestre = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        errores = new();
        // Las listas desplegables: los registros ACTIVOS de cada tabla padre,
        // pedidos a la API por el servicio de esa tabla.
        var rActivAcademicasIdcurso = await ServicioActivAcademicaPadre.Listar();
        if (rActivAcademicasIdcurso.Ok) listaActivAcademicasIdcurso = rActivAcademicasIdcurso.Datos!;
        else errores.AddRange(rActivAcademicasIdcurso.Errores);
        var rRegistroCalificadoCodigo = await ServicioRegistroCalificadoPadre.Listar();
        if (rRegistroCalificadoCodigo.Ok) listaRegistroCalificadoCodigo = rRegistroCalificadoCodigo.Datos!;
        else errores.AddRange(rRegistroCalificadoCodigo.Errores);
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        var r = await Servicio.Listar();
        cargando = false;

        if (!r.Ok) errores.AddRange(r.Errores);
        filas = r.Ok ? r.Datos! : new();
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombreActivAcademicasIdcurso(int? llave)
    {
        if (llave == null) return "—";
        var p = listaActivAcademicasIdcurso.FirstOrDefault(x => Equals(x.Id, llave));
        return p == null ? $"{llave}" : $"{p.Id} — {p.Nombre}";
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombreRegistroCalificadoCodigo(int? llave)
    {
        if (llave == null) return "—";
        var p = listaRegistroCalificadoCodigo.FirstOrDefault(x => Equals(x.Codigo, llave));
        return p == null ? $"{llave}" : $"{p.Codigo} — {p.TipoTitulacion}";
    }

    private AaRc Construir() => new AaRc
    {
            ActivAcademicasIdcurso = campoActivAcademicasIdcurso,
            RegistroCalificadoCodigo = campoRegistroCalificadoCodigo,
            Componente = campoComponente.Trim(),
            Semestre = campoSemestre.Trim()
    };

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Editar(AaRc fila)
    {
        campoActivAcademicasIdcurso = fila.ActivAcademicasIdcurso;
        campoRegistroCalificadoCodigo = fila.RegistroCalificadoCodigo;
        campoComponente = fila.Componente;
        campoSemestre = fila.Semestre;
        original = new AaRc
        {
            ActivAcademicasIdcurso = fila.ActivAcademicasIdcurso,
            RegistroCalificadoCodigo = fila.RegistroCalificadoCodigo,
            Componente = fila.Componente,
            Semestre = fila.Semestre
        };
        editando = true;
        mostrandoFormulario = true;
        errores = new();
        exito = string.Empty;
    }

    private async Task GuardarCompleta()
    {
        guardando = true;
        var r = await Servicio.Reemplazar(campoActivAcademicasIdcurso!.Value, campoRegistroCalificadoCodigo!.Value, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó la relación {campoActivAcademicasIdcurso} / {campoRegistroCalificadoCodigo}.");
    }

    private async Task GuardarLoQueCambio()
    {
        guardando = true;
        var r = await Servicio.Actualizar(campoActivAcademicasIdcurso!.Value, campoRegistroCalificadoCodigo!.Value, original!, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó la relación {campoActivAcademicasIdcurso} / {campoRegistroCalificadoCodigo}.");
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoActivAcademicasIdcurso = null;
        campoRegistroCalificadoCodigo = null;
        campoComponente = string.Empty;
        campoSemestre = string.Empty;
        original = null;
        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;
        var r = await Servicio.Crear(Construir());
        guardando = false;
        await TrasGuardar(r, "Se agregó el registro.");
    }

    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(AaRc fila)
    {
        var seguro = await JS.InvokeAsync<bool>("confirm", $"¿Retirar {fila.ActivAcademicasIdcurso} / {fila.RegistroCalificadoCodigo} del uso?");
        if (!seguro) return;

        var r = await Servicio.Eliminar(fila.ActivAcademicasIdcurso!.Value, fila.RegistroCalificadoCodigo!.Value);
        if (r.Ok)
        {
            exito = $"Se retiró la relación {fila.ActivAcademicasIdcurso} / {fila.RegistroCalificadoCodigo}.";
            errores = new();
            await Cargar();
        }
        else
        {
            // Un 409 llega aquí con su explicación: «tiene registros activos en…».
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
