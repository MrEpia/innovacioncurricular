@page "/alianzas"
@rendermode InteractiveServer
@inject ServicioAlianza Servicio
@inject ServicioAliado ServicioAliadoPadre
@inject ServicioPrograma ServicioProgramaPadre
@inject IJSRuntime JS

@*
    LA PANTALLA DE `alianza` (v2 — bloque Actividades)

    El mismo patrón de las pantallas de la v1, con una diferencia: cada clave
    foránea es una LISTA DESPLEGABLE cargada desde la API por el servicio de
    su tabla padre, nunca escrita a mano ni leída de la base.
*@

<PageTitle>Alianzas</PageTitle>

<div class="encabezado">
    <div>
        <h1>Alianzas</h1>
        <p class="nota">Las alianzas formales entre un aliado externo y un programa académico.</p>
    </div>
    @if (!mostrandoFormulario)
    {
        <button class="boton primario" @onclick="Agregar">Agregar</button>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}
@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">
        <h2>@(editando ? "Editar" : "Agregar") la alianza</h2>

        <label>
            Aliado
            <select @bind="campoAliado" disabled="@editando">
                <option value="">— seleccione —</option>
                @foreach (var p in listaAliado)
                {
                    <option value="@p.Nit">@p.Nit — @p.RazonSocial</option>
                }
            </select>
        </label>

        <label>
            Departamento (programa)
            <select @bind="campoDepartamento" disabled="@editando">
                <option value="">— seleccione —</option>
                @foreach (var p in listaDepartamento)
                {
                    <option value="@p.Id">@p.Id — @p.Nombre</option>
                }
            </select>
        </label>

        <label>
            Fecha de inicio
            <input type="date" @bind="campoFechaInicio" />
        </label>

        <label>
            Fecha de fin
            <input type="date" @bind="campoFechaFin" />
            <span class="ayuda">Opcional.</span>
        </label>

        <label>
            Docente responsable (documento)
            <input type="number" @bind="campoDocente" />
            <span class="ayuda">Opcional.</span>
        </label>

        <div class="pareja">
            @if (editando)
            {
                <button class="boton primario" @onclick="GuardarCompleta" disabled="@guardando">
                    Guardar la ficha completa
                </button>
                <button class="boton" @onclick="GuardarLoQueCambio" disabled="@guardando">
                    Guardar solo lo que cambié
                </button>
            }
            else
            {
                <button class="boton primario" @onclick="Crear" disabled="@guardando">
                    Agregar
                </button>
            }
            <button class="boton" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
        </div>

        @if (editando)
        {
            <span class="ayuda">
                «La ficha completa» exige todos los datos obligatorios. «Solo lo que
                cambié» guarda únicamente lo que usted modificó.
            </span>
        }
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>Aliado</th>
                    <th>Departamento (programa)</th>
                    <th>Fecha de inicio</th>
                    <th>Fecha de fin</th>
                    <th>Docente responsable (documento)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td>@NombreAliado(fila.Aliado)</td>
                        <td>@NombreDepartamento(fila.Departamento)</td>
                        <td>@(fila.FechaInicio?.ToString("yyyy-MM-dd"))</td>
                        <td>@(fila.FechaFin?.ToString("yyyy-MM-dd"))</td>
                        <td>@fila.Docente</td>
                        <td>
                            <div class="acciones">
                                <button class="boton" @onclick="() => Editar(fila)">Editar</button>
                                <button class="boton peligro" @onclick="() => Retirar(fila)">Retirar</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="nota">@filas.Count registro(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay registros. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<Alianza> filas = new();
    private List<Aliado> listaAliado = new();
    private List<Programa> listaDepartamento = new();
    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;
    private Alianza? original;

    private int? campoAliado;
    private int? campoDepartamento;
    private DateTime? campoFechaInicio;
    private DateTime? campoFechaFin;
    private int? campoDocente;

    protected override async Task OnInitializedAsync()
    {
        errores = new();
        // Las listas desplegables: los registros ACTIVOS de cada tabla padre,
        // pedidos a la API por el servicio de esa tabla.
        var rAliado = await ServicioAliadoPadre.Listar();
        if (rAliado.Ok) listaAliado = rAliado.Datos!;
        else errores.AddRange(rAliado.Errores);
        var rDepartamento = await ServicioProgramaPadre.Listar();
        if (rDepartamento.Ok) listaDepartamento = rDepartamento.Datos!;
        else errores.AddRange(rDepartamento.Errores);
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        var r = await Servicio.Listar();
        cargando = false;

        if (!r.Ok) errores.AddRange(r.Errores);
        filas = r.Ok ? r.Datos! : new();
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombreAliado(int? llave)
    {
        if (llave == null) return "—";
        var p = listaAliado.FirstOrDefault(x => Equals(x.Nit, llave));
        return p == null ? $"{llave}" : $"{p.Nit} — {p.RazonSocial}";
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombreDepartamento(int? llave)
    {
        if (llave == null) return "—";
        var p = listaDepartamento.FirstOrDefault(x => Equals(x.Id, llave));
        return p == null ? $"{llave}" : $"{p.Id} — {p.Nombre}";
    }

    private Alianza Construir() => new Alianza
    {
            Aliado = campoAliado,
            Departamento = campoDepartamento,
            FechaInicio = campoFechaInicio,
            FechaFin = campoFechaFin,
            Docente = campoDocente
    };

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Editar(Alianza fila)
    {
        campoAliado = fila.Aliado;
        campoDepartamento = fila.Departamento;
        campoFechaInicio = fila.FechaInicio;
        campoFechaFin = fila.FechaFin;
        campoDocente = fila.Docente;
        original = new Alianza
        {
            Aliado = fila.Aliado,
            Departamento = fila.Departamento,
            FechaInicio = fila.FechaInicio,
            FechaFin = fila.FechaFin,
            Docente = fila.Docente
        };
        editando = true;
        mostrandoFormulario = true;
        errores = new();
        exito = string.Empty;
    }

    private async Task GuardarCompleta()
    {
        guardando = true;
        var r = await Servicio.Reemplazar(campoAliado!.Value, campoDepartamento!.Value, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó la alianza {campoAliado} / {campoDepartamento}.");
    }

    private async Task GuardarLoQueCambio()
    {
        guardando = true;
        var r = await Servicio.Actualizar(campoAliado!.Value, campoDepartamento!.Value, original!, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó la alianza {campoAliado} / {campoDepartamento}.");
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoAliado = null;
        campoDepartamento = null;
        campoFechaInicio = null;
        campoFechaFin = null;
        campoDocente = null;
        original = null;
        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;
        var r = await Servicio.Crear(Construir());
        guardando = false;
        await TrasGuardar(r, "Se agregó el registro.");
    }

    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(Alianza fila)
    {
        var seguro = await JS.InvokeAsync<bool>("confirm", $"¿Retirar {fila.Aliado} / {fila.Departamento} del uso?");
        if (!seguro) return;

        var r = await Servicio.Eliminar(fila.Aliado!.Value, fila.Departamento!.Value);
        if (r.Ok)
        {
            exito = $"Se retiró la alianza {fila.Aliado} / {fila.Departamento}.";
            errores = new();
            await Cargar();
        }
        else
        {
            // Un 409 llega aquí con su explicación: «tiene registros activos en…».
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
