@page "/docentes-departamentos"
@rendermode InteractiveServer
@inject ServicioDocenteDepartamento Servicio
@inject ServicioPrograma ServicioProgramaPadre
@inject IJSRuntime JS

@*
    LA PANTALLA DE `docente_departamento` (v2 — bloque Actividades)

    El mismo patrón de las pantallas de la v1, con una diferencia: cada clave
    foránea es una LISTA DESPLEGABLE cargada desde la API por el servicio de
    su tabla padre, nunca escrita a mano ni leída de la base.
*@

<PageTitle>Docentes por departamento</PageTitle>

<div class="encabezado">
    <div>
        <h1>Docentes por departamento</h1>
        <p class="nota">La vinculación de cada docente a un programa (departamento): dedicación, modalidad y fechas.</p>
    </div>
    @if (!mostrandoFormulario)
    {
        <AuthorizeView Roles="administrador,editor" Context="permiso"><button class="boton primario" @onclick="Agregar">Agregar</button></AuthorizeView>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}
@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">
        <h2>@(editando ? "Editar" : "Agregar") la vinculación</h2>

        <label>
            Docente (documento)
            <input type="number" @bind="campoDocente" disabled="@editando" />
            <span class="ayuda">Forma parte de la llave: no se podrá cambiar después.</span>
        </label>

        <label>
            Departamento (programa)
            <select @bind="campoDepartamento" disabled="@editando">
                <option value="">— seleccione —</option>
                @foreach (var p in listaDepartamento)
                {
                    <option value="@p.Id">@p.Id — @p.Nombre</option>
                }
            </select>
        </label>

        <label>
            Dedicación
            <select @bind="campoDedicacion">
                <option value="">— seleccione —</option>
                <option value="Tiempo Completo">Tiempo Completo</option>
                <option value="Medio Tiempo">Medio Tiempo</option>
                <option value="Cátedra">Cátedra</option>
            </select>
        </label>

        <label>
            Modalidad
            <input type="text" maxlength="45" @bind="campoModalidad" />
        </label>

        <label>
            Fecha de ingreso
            <input type="date" @bind="campoFechaIngreso" />
        </label>

        <label>
            Fecha de salida
            <input type="date" @bind="campoFechaSalida" />
            <span class="ayuda">Opcional.</span>
        </label>

        <div class="pareja">
            @if (editando)
            {
                <button class="boton primario" @onclick="GuardarCompleta" disabled="@guardando">
                    Guardar la ficha completa
                </button>
                <button class="boton" @onclick="GuardarLoQueCambio" disabled="@guardando">
                    Guardar solo lo que cambié
                </button>
            }
            else
            {
                <button class="boton primario" @onclick="Crear" disabled="@guardando">
                    Agregar
                </button>
            }
            <button class="boton" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
        </div>

        @if (editando)
        {
            <span class="ayuda">
                «La ficha completa» exige todos los datos obligatorios. «Solo lo que
                cambié» guarda únicamente lo que usted modificó.
            </span>
        }
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>Docente (documento)</th>
                    <th>Departamento (programa)</th>
                    <th>Dedicación</th>
                    <th>Modalidad</th>
                    <th>Fecha de ingreso</th>
                    <th>Fecha de salida</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td>@fila.Docente</td>
                        <td>@NombreDepartamento(fila.Departamento)</td>
                        <td>@fila.Dedicacion</td>
                        <td>@fila.Modalidad</td>
                        <td>@(fila.FechaIngreso?.ToString("yyyy-MM-dd"))</td>
                        <td>@(fila.FechaSalida?.ToString("yyyy-MM-dd"))</td>
                        <td>
                            <div class="acciones">
                                <AuthorizeView Roles="administrador,editor" Context="permiso"><button class="boton" @onclick="() => Editar(fila)">Editar</button></AuthorizeView>
                                <AuthorizeView Roles="administrador" Context="permiso"><button class="boton peligro" @onclick="() => Retirar(fila)">Retirar</button></AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="nota">@filas.Count registro(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay registros. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<DocenteDepartamento> filas = new();
    private List<Programa> listaDepartamento = new();
    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;
    private DocenteDepartamento? original;

    private int? campoDocente;
    private int? campoDepartamento;
    private string campoDedicacion = string.Empty;
    private string campoModalidad = string.Empty;
    private DateTime? campoFechaIngreso;
    private DateTime? campoFechaSalida;

    protected override async Task OnInitializedAsync()
    {
        errores = new();
        // Las listas desplegables: los registros ACTIVOS de cada tabla padre,
        // pedidos a la API por el servicio de esa tabla.
        var rDepartamento = await ServicioProgramaPadre.Listar();
        if (rDepartamento.Ok) listaDepartamento = rDepartamento.Datos!;
        else errores.AddRange(rDepartamento.Errores);
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        var r = await Servicio.Listar();
        cargando = false;

        if (!r.Ok) errores.AddRange(r.Errores);
        filas = r.Ok ? r.Datos! : new();
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombreDepartamento(int? llave)
    {
        if (llave == null) return "—";
        var p = listaDepartamento.FirstOrDefault(x => Equals(x.Id, llave));
        return p == null ? $"{llave}" : $"{p.Id} — {p.Nombre}";
    }

    private DocenteDepartamento Construir() => new DocenteDepartamento
    {
            Docente = campoDocente,
            Departamento = campoDepartamento,
            Dedicacion = campoDedicacion.Trim(),
            Modalidad = campoModalidad.Trim(),
            FechaIngreso = campoFechaIngreso,
            FechaSalida = campoFechaSalida
    };

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Editar(DocenteDepartamento fila)
    {
        campoDocente = fila.Docente;
        campoDepartamento = fila.Departamento;
        campoDedicacion = fila.Dedicacion;
        campoModalidad = fila.Modalidad;
        campoFechaIngreso = fila.FechaIngreso;
        campoFechaSalida = fila.FechaSalida;
        original = new DocenteDepartamento
        {
            Docente = fila.Docente,
            Departamento = fila.Departamento,
            Dedicacion = fila.Dedicacion,
            Modalidad = fila.Modalidad,
            FechaIngreso = fila.FechaIngreso,
            FechaSalida = fila.FechaSalida
        };
        editando = true;
        mostrandoFormulario = true;
        errores = new();
        exito = string.Empty;
    }

    private async Task GuardarCompleta()
    {
        guardando = true;
        var r = await Servicio.Reemplazar(campoDocente!.Value, campoDepartamento!.Value, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó la vinculación {campoDocente} / {campoDepartamento}.");
    }

    private async Task GuardarLoQueCambio()
    {
        guardando = true;
        var r = await Servicio.Actualizar(campoDocente!.Value, campoDepartamento!.Value, original!, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó la vinculación {campoDocente} / {campoDepartamento}.");
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoDocente = null;
        campoDepartamento = null;
        campoDedicacion = string.Empty;
        campoModalidad = string.Empty;
        campoFechaIngreso = null;
        campoFechaSalida = null;
        original = null;
        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;
        var r = await Servicio.Crear(Construir());
        guardando = false;
        await TrasGuardar(r, "Se agregó el registro.");
    }

    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(DocenteDepartamento fila)
    {
        var seguro = await JS.InvokeAsync<bool>("confirm", $"¿Retirar {fila.Docente} / {fila.Departamento} del uso?");
        if (!seguro) return;

        var r = await Servicio.Eliminar(fila.Docente!.Value, fila.Departamento!.Value);
        if (r.Ok)
        {
            exito = $"Se retiró la vinculación {fila.Docente} / {fila.Departamento}.";
            errores = new();
            await Cargar();
        }
        else
        {
            // Un 409 llega aquí con su explicación: «tiene registros activos en…».
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
