@page "/enfoques-registros"
@rendermode InteractiveServer
@inject ServicioEnfoqueRc Servicio
@inject ServicioEnfoque ServicioEnfoquePadre
@inject ServicioRegistroCalificado ServicioRegistroCalificadoPadre
@inject IJSRuntime JS

@*
    LA PANTALLA DE `enfoque_rc` (v2 — bloque Puentes)

    El mismo patrón de las pantallas de la v1, con una diferencia: cada clave
    foránea es una LISTA DESPLEGABLE cargada desde la API por el servicio de
    su tabla padre, nunca escrita a mano ni leída de la base.
*@

<PageTitle>Enfoques por registro calificado</PageTitle>

<div class="encabezado">
    <div>
        <h1>Enfoques por registro calificado</h1>
        <p class="nota">Qué enfoques pedagógicos declara cada registro calificado.</p>
    </div>
    @if (!mostrandoFormulario)
    {
        <button class="boton primario" @onclick="Agregar">Agregar</button>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}
@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">
        <h2>@(editando ? "Editar" : "Agregar") la relación</h2>

        <label>
            Enfoque
            <select @bind="campoEnfoque" disabled="@editando">
                <option value="">— seleccione —</option>
                @foreach (var p in listaEnfoque)
                {
                    <option value="@p.Id">@p.Id — @p.Nombre</option>
                }
            </select>
        </label>

        <label>
            Registro calificado
            <select @bind="campoRegistroCalificado" disabled="@editando">
                <option value="">— seleccione —</option>
                @foreach (var p in listaRegistroCalificado)
                {
                    <option value="@p.Codigo">@p.Codigo — @p.TipoTitulacion</option>
                }
            </select>
        </label>

        <div class="pareja">
            <button class="boton primario" @onclick="Crear" disabled="@guardando">
                Agregar
            </button>
            <button class="boton" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
        </div>

        <span class="ayuda">
            Una relación no se edita: si cambió, retire esta y agregue la nueva.
        </span>
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>Enfoque</th>
                    <th>Registro calificado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td>@NombreEnfoque(fila.Enfoque)</td>
                        <td>@NombreRegistroCalificado(fila.RegistroCalificado)</td>
                        <td>
                            <div class="acciones">
                                <button class="boton peligro" @onclick="() => Retirar(fila)">Retirar</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="nota">@filas.Count registro(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay registros. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<EnfoqueRc> filas = new();
    private List<Enfoque> listaEnfoque = new();
    private List<RegistroCalificado> listaRegistroCalificado = new();
    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;
    private EnfoqueRc? original;

    private int? campoEnfoque;
    private int? campoRegistroCalificado;

    protected override async Task OnInitializedAsync()
    {
        errores = new();
        // Las listas desplegables: los registros ACTIVOS de cada tabla padre,
        // pedidos a la API por el servicio de esa tabla.
        var rEnfoque = await ServicioEnfoquePadre.Listar();
        if (rEnfoque.Ok) listaEnfoque = rEnfoque.Datos!;
        else errores.AddRange(rEnfoque.Errores);
        var rRegistroCalificado = await ServicioRegistroCalificadoPadre.Listar();
        if (rRegistroCalificado.Ok) listaRegistroCalificado = rRegistroCalificado.Datos!;
        else errores.AddRange(rRegistroCalificado.Errores);
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        var r = await Servicio.Listar();
        cargando = false;

        if (!r.Ok) errores.AddRange(r.Errores);
        filas = r.Ok ? r.Datos! : new();
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombreEnfoque(int? llave)
    {
        if (llave == null) return "—";
        var p = listaEnfoque.FirstOrDefault(x => Equals(x.Id, llave));
        return p == null ? $"{llave}" : $"{p.Id} — {p.Nombre}";
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombreRegistroCalificado(int? llave)
    {
        if (llave == null) return "—";
        var p = listaRegistroCalificado.FirstOrDefault(x => Equals(x.Codigo, llave));
        return p == null ? $"{llave}" : $"{p.Codigo} — {p.TipoTitulacion}";
    }

    private EnfoqueRc Construir() => new EnfoqueRc
    {
            Enfoque = campoEnfoque,
            RegistroCalificado = campoRegistroCalificado
    };

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoEnfoque = null;
        campoRegistroCalificado = null;
        original = null;
        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;
        var r = await Servicio.Crear(Construir());
        guardando = false;
        await TrasGuardar(r, "Se agregó el registro.");
    }

    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(EnfoqueRc fila)
    {
        var seguro = await JS.InvokeAsync<bool>("confirm", $"¿Retirar {fila.Enfoque} / {fila.RegistroCalificado} del uso?");
        if (!seguro) return;

        var r = await Servicio.Eliminar(fila.Enfoque!.Value, fila.RegistroCalificado!.Value);
        if (r.Ok)
        {
            exito = $"Se retiró la relación {fila.Enfoque} / {fila.RegistroCalificado}.";
            errores = new();
            await Cargar();
        }
        else
        {
            // Un 409 llega aquí con su explicación: «tiene registros activos en…».
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
