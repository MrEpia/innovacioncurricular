@page "/premios"
@rendermode InteractiveServer
@inject ServicioPremio Servicio
@inject ServicioPrograma ServicioProgramaPadre
@inject IJSRuntime JS

@*
    LA PANTALLA DE `premio` (v2 — bloque Actividades)

    El mismo patrón de las pantallas de la v1, con una diferencia: cada clave
    foránea es una LISTA DESPLEGABLE cargada desde la API por el servicio de
    su tabla padre, nunca escrita a mano ni leída de la base.
*@

<PageTitle>Premios</PageTitle>

<div class="encabezado">
    <div>
        <h1>Premios</h1>
        <p class="nota">Los premios y reconocimientos recibidos por los programas, con la entidad que los otorga.</p>
    </div>
    @if (!mostrandoFormulario)
    {
        <AuthorizeView Roles="administrador,editor" Context="permiso"><button class="boton primario" @onclick="Agregar">Agregar</button></AuthorizeView>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}
@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">
        <h2>@(editando ? "Editar" : "Agregar") el premio</h2>

        <label>
            ID
            <input type="number" @bind="campoId" disabled="@editando" />
            <span class="ayuda">Forma parte de la llave: no se podrá cambiar después.</span>
        </label>

        <label>
            Nombre
            <input type="text" maxlength="45" @bind="campoNombre" />
        </label>

        <label>
            Descripción
            <input type="text" maxlength="45" @bind="campoDescripcion" />
        </label>

        <label>
            Fecha
            <input type="date" @bind="campoFecha" />
        </label>

        <label>
            Entidad otorgante
            <input type="text" maxlength="45" @bind="campoEntidadOtorgante" />
        </label>

        <label>
            País
            <input type="text" maxlength="45" @bind="campoPais" />
        </label>

        <label>
            Programa
            <select @bind="campoPrograma">
                <option value="">— seleccione —</option>
                @foreach (var p in listaPrograma)
                {
                    <option value="@p.Id">@p.Id — @p.Nombre</option>
                }
            </select>
        </label>

        <div class="pareja">
            @if (editando)
            {
                <button class="boton primario" @onclick="GuardarCompleta" disabled="@guardando">
                    Guardar la ficha completa
                </button>
                <button class="boton" @onclick="GuardarLoQueCambio" disabled="@guardando">
                    Guardar solo lo que cambié
                </button>
            }
            else
            {
                <button class="boton primario" @onclick="Crear" disabled="@guardando">
                    Agregar
                </button>
            }
            <button class="boton" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
        </div>

        @if (editando)
        {
            <span class="ayuda">
                «La ficha completa» exige todos los datos obligatorios. «Solo lo que
                cambié» guarda únicamente lo que usted modificó.
            </span>
        }
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Fecha</th>
                    <th>Entidad otorgante</th>
                    <th>País</th>
                    <th>Programa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td>@fila.Id</td>
                        <td>@fila.Nombre</td>
                        <td>@fila.Descripcion</td>
                        <td>@(fila.Fecha?.ToString("yyyy-MM-dd"))</td>
                        <td>@fila.EntidadOtorgante</td>
                        <td>@fila.Pais</td>
                        <td>@NombrePrograma(fila.Programa)</td>
                        <td>
                            <div class="acciones">
                                <AuthorizeView Roles="administrador,editor" Context="permiso"><button class="boton" @onclick="() => Editar(fila)">Editar</button></AuthorizeView>
                                <AuthorizeView Roles="administrador" Context="permiso"><button class="boton peligro" @onclick="() => Retirar(fila)">Retirar</button></AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="nota">@filas.Count registro(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay registros. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<Premio> filas = new();
    private List<Programa> listaPrograma = new();
    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;
    private Premio? original;

    private int? campoId;
    private string campoNombre = string.Empty;
    private string campoDescripcion = string.Empty;
    private DateTime? campoFecha;
    private string campoEntidadOtorgante = string.Empty;
    private string campoPais = string.Empty;
    private int? campoPrograma;

    protected override async Task OnInitializedAsync()
    {
        errores = new();
        // Las listas desplegables: los registros ACTIVOS de cada tabla padre,
        // pedidos a la API por el servicio de esa tabla.
        var rPrograma = await ServicioProgramaPadre.Listar();
        if (rPrograma.Ok) listaPrograma = rPrograma.Datos!;
        else errores.AddRange(rPrograma.Errores);
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        var r = await Servicio.Listar();
        cargando = false;

        if (!r.Ok) errores.AddRange(r.Errores);
        filas = r.Ok ? r.Datos! : new();
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombrePrograma(int? llave)
    {
        if (llave == null) return "—";
        var p = listaPrograma.FirstOrDefault(x => Equals(x.Id, llave));
        return p == null ? $"{llave}" : $"{p.Id} — {p.Nombre}";
    }

    private Premio Construir() => new Premio
    {
            Id = campoId,
            Nombre = campoNombre.Trim(),
            Descripcion = campoDescripcion.Trim(),
            Fecha = campoFecha,
            EntidadOtorgante = campoEntidadOtorgante.Trim(),
            Pais = campoPais.Trim(),
            Programa = campoPrograma
    };

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Editar(Premio fila)
    {
        campoId = fila.Id;
        campoNombre = fila.Nombre;
        campoDescripcion = fila.Descripcion;
        campoFecha = fila.Fecha;
        campoEntidadOtorgante = fila.EntidadOtorgante;
        campoPais = fila.Pais;
        campoPrograma = fila.Programa;
        original = new Premio
        {
            Id = fila.Id,
            Nombre = fila.Nombre,
            Descripcion = fila.Descripcion,
            Fecha = fila.Fecha,
            EntidadOtorgante = fila.EntidadOtorgante,
            Pais = fila.Pais,
            Programa = fila.Programa
        };
        editando = true;
        mostrandoFormulario = true;
        errores = new();
        exito = string.Empty;
    }

    private async Task GuardarCompleta()
    {
        guardando = true;
        var r = await Servicio.Reemplazar(campoId!.Value, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó el premio {campoId}.");
    }

    private async Task GuardarLoQueCambio()
    {
        guardando = true;
        var r = await Servicio.Actualizar(campoId!.Value, original!, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó el premio {campoId}.");
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoId = null;
        campoNombre = string.Empty;
        campoDescripcion = string.Empty;
        campoFecha = null;
        campoEntidadOtorgante = string.Empty;
        campoPais = string.Empty;
        campoPrograma = null;
        original = null;
        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;
        var r = await Servicio.Crear(Construir());
        guardando = false;
        await TrasGuardar(r, "Se agregó el registro.");
    }

    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(Premio fila)
    {
        var seguro = await JS.InvokeAsync<bool>("confirm", $"¿Retirar {fila.Id} del uso?");
        if (!seguro) return;

        var r = await Servicio.Eliminar(fila.Id!.Value);
        if (r.Ok)
        {
            exito = $"Se retiró el premio {fila.Id}.";
            errores = new();
            await Cargar();
        }
        else
        {
            // Un 409 llega aquí con su explicación: «tiene registros activos en…».
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
