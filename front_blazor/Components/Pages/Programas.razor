@page "/programas"
@rendermode InteractiveServer
@inject ServicioPrograma Servicio
@inject ServicioFacultad ServicioFacultadPadre
@inject IJSRuntime JS

@*
    LA PANTALLA DE `programa` (v2 — bloque Academico)

    El mismo patrón de las pantallas de la v1, con una diferencia: cada clave
    foránea es una LISTA DESPLEGABLE cargada desde la API por el servicio de
    su tabla padre, nunca escrita a mano ni leída de la base.
*@

<PageTitle>Programas académicos</PageTitle>

<div class="encabezado">
    <div>
        <h1>Programas académicos</h1>
        <p class="nota">Los programas de pregrado y posgrado que ofrece cada facultad.</p>
    </div>
    @if (!mostrandoFormulario)
    {
        <button class="boton primario" @onclick="Agregar">Agregar</button>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}
@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">
        <h2>@(editando ? "Editar" : "Agregar") el programa</h2>

        <label>
            ID
            <input type="number" @bind="campoId" disabled="@editando" />
            <span class="ayuda">Forma parte de la llave: no se podrá cambiar después.</span>
        </label>

        <label>
            Nombre
            <input type="text" maxlength="150" @bind="campoNombre" />
        </label>

        <label>
            Tipo
            <input type="text" maxlength="45" @bind="campoTipo" />
        </label>

        <label>
            Nivel
            <input type="text" maxlength="45" @bind="campoNivel" />
        </label>

        <label>
            Fecha de creación
            <input type="text" maxlength="45" @bind="campoFechaCreacion" />
        </label>

        <label>
            Fecha de cierre
            <input type="text" maxlength="45" @bind="campoFechaCierre" />
            <span class="ayuda">Opcional.</span>
        </label>

        <label>
            Número de cohortes
            <input type="text" maxlength="45" @bind="campoNumeroCohortes" />
        </label>

        <label>
            Cantidad de graduados
            <input type="text" maxlength="45" @bind="campoCantGraduados" />
        </label>

        <label>
            Fecha de actualización
            <input type="text" maxlength="45" @bind="campoFechaActualizacion" />
        </label>

        <label>
            Ciudad
            <input type="text" maxlength="45" @bind="campoCiudad" />
        </label>

        <label>
            Facultad
            <select @bind="campoFacultad">
                <option value="">— seleccione —</option>
                @foreach (var p in listaFacultad)
                {
                    <option value="@p.Id">@p.Id — @p.Nombre</option>
                }
            </select>
        </label>

        <div class="pareja">
            @if (editando)
            {
                <button class="boton primario" @onclick="GuardarCompleta" disabled="@guardando">
                    Guardar la ficha completa
                </button>
                <button class="boton" @onclick="GuardarLoQueCambio" disabled="@guardando">
                    Guardar solo lo que cambié
                </button>
            }
            else
            {
                <button class="boton primario" @onclick="Crear" disabled="@guardando">
                    Agregar
                </button>
            }
            <button class="boton" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
        </div>

        @if (editando)
        {
            <span class="ayuda">
                «La ficha completa» exige todos los datos obligatorios. «Solo lo que
                cambié» guarda únicamente lo que usted modificó.
            </span>
        }
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Nivel</th>
                    <th>Fecha de creación</th>
                    <th>Fecha de cierre</th>
                    <th>Número de cohortes</th>
                    <th>Cantidad de graduados</th>
                    <th>Fecha de actualización</th>
                    <th>Ciudad</th>
                    <th>Facultad</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td>@fila.Id</td>
                        <td>@fila.Nombre</td>
                        <td>@fila.Tipo</td>
                        <td>@fila.Nivel</td>
                        <td>@fila.FechaCreacion</td>
                        <td>@fila.FechaCierre</td>
                        <td>@fila.NumeroCohortes</td>
                        <td>@fila.CantGraduados</td>
                        <td>@fila.FechaActualizacion</td>
                        <td>@fila.Ciudad</td>
                        <td>@NombreFacultad(fila.Facultad)</td>
                        <td>
                            <div class="acciones">
                                <button class="boton" @onclick="() => Editar(fila)">Editar</button>
                                <button class="boton peligro" @onclick="() => Retirar(fila)">Retirar</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="nota">@filas.Count registro(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay registros. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<Programa> filas = new();
    private List<Facultad> listaFacultad = new();
    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;
    private Programa? original;

    private int? campoId;
    private string campoNombre = string.Empty;
    private string campoTipo = string.Empty;
    private string campoNivel = string.Empty;
    private string campoFechaCreacion = string.Empty;
    private string? campoFechaCierre;
    private string campoNumeroCohortes = string.Empty;
    private string campoCantGraduados = string.Empty;
    private string campoFechaActualizacion = string.Empty;
    private string campoCiudad = string.Empty;
    private int? campoFacultad;

    protected override async Task OnInitializedAsync()
    {
        errores = new();
        // Las listas desplegables: los registros ACTIVOS de cada tabla padre,
        // pedidos a la API por el servicio de esa tabla.
        var rFacultad = await ServicioFacultadPadre.Listar();
        if (rFacultad.Ok) listaFacultad = rFacultad.Datos!;
        else errores.AddRange(rFacultad.Errores);
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        var r = await Servicio.Listar();
        cargando = false;

        if (!r.Ok) errores.AddRange(r.Errores);
        filas = r.Ok ? r.Datos! : new();
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombreFacultad(int? llave)
    {
        if (llave == null) return "—";
        var p = listaFacultad.FirstOrDefault(x => Equals(x.Id, llave));
        return p == null ? $"{llave}" : $"{p.Id} — {p.Nombre}";
    }

    private Programa Construir() => new Programa
    {
            Id = campoId,
            Nombre = campoNombre.Trim(),
            Tipo = campoTipo.Trim(),
            Nivel = campoNivel.Trim(),
            FechaCreacion = campoFechaCreacion.Trim(),
            FechaCierre = campoFechaCierre?.Trim(),
            NumeroCohortes = campoNumeroCohortes.Trim(),
            CantGraduados = campoCantGraduados.Trim(),
            FechaActualizacion = campoFechaActualizacion.Trim(),
            Ciudad = campoCiudad.Trim(),
            Facultad = campoFacultad
    };

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Editar(Programa fila)
    {
        campoId = fila.Id;
        campoNombre = fila.Nombre;
        campoTipo = fila.Tipo;
        campoNivel = fila.Nivel;
        campoFechaCreacion = fila.FechaCreacion;
        campoFechaCierre = fila.FechaCierre;
        campoNumeroCohortes = fila.NumeroCohortes;
        campoCantGraduados = fila.CantGraduados;
        campoFechaActualizacion = fila.FechaActualizacion;
        campoCiudad = fila.Ciudad;
        campoFacultad = fila.Facultad;
        original = new Programa
        {
            Id = fila.Id,
            Nombre = fila.Nombre,
            Tipo = fila.Tipo,
            Nivel = fila.Nivel,
            FechaCreacion = fila.FechaCreacion,
            FechaCierre = fila.FechaCierre,
            NumeroCohortes = fila.NumeroCohortes,
            CantGraduados = fila.CantGraduados,
            FechaActualizacion = fila.FechaActualizacion,
            Ciudad = fila.Ciudad,
            Facultad = fila.Facultad
        };
        editando = true;
        mostrandoFormulario = true;
        errores = new();
        exito = string.Empty;
    }

    private async Task GuardarCompleta()
    {
        guardando = true;
        var r = await Servicio.Reemplazar(campoId!.Value, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó el programa {campoId}.");
    }

    private async Task GuardarLoQueCambio()
    {
        guardando = true;
        var r = await Servicio.Actualizar(campoId!.Value, original!, Construir());
        guardando = false;
        await TrasGuardar(r, $"Se guardó el programa {campoId}.");
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoId = null;
        campoNombre = string.Empty;
        campoTipo = string.Empty;
        campoNivel = string.Empty;
        campoFechaCreacion = string.Empty;
        campoFechaCierre = null;
        campoNumeroCohortes = string.Empty;
        campoCantGraduados = string.Empty;
        campoFechaActualizacion = string.Empty;
        campoCiudad = string.Empty;
        campoFacultad = null;
        original = null;
        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;
        var r = await Servicio.Crear(Construir());
        guardando = false;
        await TrasGuardar(r, "Se agregó el registro.");
    }

    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(Programa fila)
    {
        var seguro = await JS.InvokeAsync<bool>("confirm", $"¿Retirar {fila.Id} del uso?");
        if (!seguro) return;

        var r = await Servicio.Eliminar(fila.Id!.Value);
        if (r.Ok)
        {
            exito = $"Se retiró el programa {fila.Id}.";
            errores = new();
            await Cargar();
        }
        else
        {
            // Un 409 llega aquí con su explicación: «tiene registros activos en…».
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
