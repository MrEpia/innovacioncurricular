@page "/programas-practicas"
@rendermode InteractiveServer
@inject ServicioProgramaPe Servicio
@inject ServicioPrograma ServicioProgramaPadre
@inject ServicioPracticaEstrategia ServicioPracticaEstrategiaPadre
@inject IJSRuntime JS

@*
    LA PANTALLA DE `programa_pe` (v2 — bloque Puentes)

    El mismo patrón de las pantallas de la v1, con una diferencia: cada clave
    foránea es una LISTA DESPLEGABLE cargada desde la API por el servicio de
    su tabla padre, nunca escrita a mano ni leída de la base.
*@

<PageTitle>Programas y prácticas</PageTitle>

<div class="encabezado">
    <div>
        <h1>Programas y prácticas</h1>
        <p class="nota">Qué prácticas y estrategias pedagógicas aplica cada programa.</p>
    </div>
    @if (!mostrandoFormulario)
    {
        <AuthorizeView Roles="administrador,editor" Context="permiso"><button class="boton primario" @onclick="Agregar">Agregar</button></AuthorizeView>
    }
</div>

@foreach (var error in errores)
{
    <p class="aviso error">@error</p>
}
@if (!string.IsNullOrEmpty(exito))
{
    <p class="aviso exito">@exito</p>
}

@if (mostrandoFormulario)
{
    <div class="tarjeta-formulario">
        <h2>@(editando ? "Editar" : "Agregar") la relación</h2>

        <label>
            Programa
            <select @bind="campoPrograma" disabled="@editando">
                <option value="">— seleccione —</option>
                @foreach (var p in listaPrograma)
                {
                    <option value="@p.Id">@p.Id — @p.Nombre</option>
                }
            </select>
        </label>

        <label>
            Práctica o estrategia
            <select @bind="campoPracticaEstrategia" disabled="@editando">
                <option value="">— seleccione —</option>
                @foreach (var p in listaPracticaEstrategia)
                {
                    <option value="@p.Id">@p.Id — @p.Nombre</option>
                }
            </select>
        </label>

        <div class="pareja">
            <button class="boton primario" @onclick="Crear" disabled="@guardando">
                Agregar
            </button>
            <button class="boton" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
        </div>

        <span class="ayuda">
            Una relación no se edita: si cambió, retire esta y agregue la nueva.
        </span>
    </div>
}

@if (cargando)
{
    <p class="nota">Cargando…</p>
}
else if (filas.Count > 0)
{
    <div class="tabla-scroll">
        <table>
            <thead>
                <tr>
                    <th>Programa</th>
                    <th>Práctica o estrategia</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in filas)
                {
                    <tr>
                        <td>@NombrePrograma(fila.Programa)</td>
                        <td>@NombrePracticaEstrategia(fila.PracticaEstrategia)</td>
                        <td>
                            <div class="acciones">
                                <AuthorizeView Roles="administrador" Context="permiso"><button class="boton peligro" @onclick="() => Retirar(fila)">Retirar</button></AuthorizeView>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="nota">@filas.Count registro(s).</p>
}
else
{
    <p class="vacio">
        Todavía no hay registros. Use «Agregar» para crear el primero.
    </p>
}

@code {
    private List<ProgramaPe> filas = new();
    private List<Programa> listaPrograma = new();
    private List<PracticaEstrategia> listaPracticaEstrategia = new();
    private List<string> errores = new();
    private string exito = string.Empty;

    private bool cargando = true;
    private bool guardando;
    private bool mostrandoFormulario;
    private bool editando;
    private ProgramaPe? original;

    private int? campoPrograma;
    private int? campoPracticaEstrategia;

    protected override async Task OnInitializedAsync()
    {
        errores = new();
        // Las listas desplegables: los registros ACTIVOS de cada tabla padre,
        // pedidos a la API por el servicio de esa tabla.
        var rPrograma = await ServicioProgramaPadre.Listar();
        if (rPrograma.Ok) listaPrograma = rPrograma.Datos!;
        else errores.AddRange(rPrograma.Errores);
        var rPracticaEstrategia = await ServicioPracticaEstrategiaPadre.Listar();
        if (rPracticaEstrategia.Ok) listaPracticaEstrategia = rPracticaEstrategia.Datos!;
        else errores.AddRange(rPracticaEstrategia.Errores);
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        var r = await Servicio.Listar();
        cargando = false;

        if (!r.Ok) errores.AddRange(r.Errores);
        filas = r.Ok ? r.Datos! : new();
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombrePrograma(int? llave)
    {
        if (llave == null) return "—";
        var p = listaPrograma.FirstOrDefault(x => Equals(x.Id, llave));
        return p == null ? $"{llave}" : $"{p.Id} — {p.Nombre}";
    }

    // Muestra «llave — nombre» con la lista que dio la API; si el padre ya no
    // está en la lista (fue retirado), muestra al menos la llave.
    private string NombrePracticaEstrategia(int? llave)
    {
        if (llave == null) return "—";
        var p = listaPracticaEstrategia.FirstOrDefault(x => Equals(x.Id, llave));
        return p == null ? $"{llave}" : $"{p.Id} — {p.Nombre}";
    }

    private ProgramaPe Construir() => new ProgramaPe
    {
            Programa = campoPrograma,
            PracticaEstrategia = campoPracticaEstrategia
    };

    private void Agregar()
    {
        Limpiar();
        editando = false;
        mostrandoFormulario = true;
    }

    private void Cancelar()
    {
        mostrandoFormulario = false;
        Limpiar();
    }

    private void Limpiar()
    {
        campoPrograma = null;
        campoPracticaEstrategia = null;
        original = null;
        errores = new();
        exito = string.Empty;
    }

    private async Task Crear()
    {
        guardando = true;
        var r = await Servicio.Crear(Construir());
        guardando = false;
        await TrasGuardar(r, "Se agregó el registro.");
    }

    private async Task TrasGuardar(Resultado<bool> r, string mensaje)
    {
        if (r.Ok)
        {
            mostrandoFormulario = false;
            exito = mensaje;
            errores = new();
            await Cargar();
        }
        else
        {
            errores = r.Errores;
            exito = string.Empty;
        }
    }

    private async Task Retirar(ProgramaPe fila)
    {
        var seguro = await JS.InvokeAsync<bool>("confirm", $"¿Retirar {fila.Programa} / {fila.PracticaEstrategia} del uso?");
        if (!seguro) return;

        var r = await Servicio.Eliminar(fila.Programa!.Value, fila.PracticaEstrategia!.Value);
        if (r.Ok)
        {
            exito = $"Se retiró la relación {fila.Programa} / {fila.PracticaEstrategia}.";
            errores = new();
            await Cargar();
        }
        else
        {
            // Un 409 llega aquí con su explicación: «tiene registros activos en…».
            errores = r.Errores;
            exito = string.Empty;
        }
    }
}
