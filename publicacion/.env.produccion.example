# ==============================================================
# Variables de la PUBLICACIÓN (entrega 4) — valores de MENTIRA.
#
#   1. Copie este archivo:  publicacion/.env.produccion
#   2. Llénelo con los datos que le da el panel del hosting.
#   3. Ese archivo NUNCA se sube a git: está en el .gitignore (Artículo 7).
# ==============================================================

# --- La base de datos del hosting (panel → Databases → MSSQL) ---
SQL_SERVIDOR=db12345.public.databaseasp.net
SQL_BASE=db12345
SQL_USUARIO=db12345
SQL_CLAVE=Cambie_Esta_Clave_123

# --- JWT: OTRO secreto distinto al local, de 32 caracteres o más ---
JWT_SECRETO=cambie-este-secreto-de-produccion-por-uno-largo-y-aleatorio
JWT_MINUTOS=60

# --- Administrador inicial del sitio publicado ---
ADMIN_USUARIO=admin
ADMIN_CORREO=admin@innovacion.test
ADMIN_CLAVE=Cambie_Esta_Clave_Admin_1

# --- La dirección PÚBLICA de la API (para el front) ---
URL_API=https://innovacion-api.runasp.net
